if [[ "$(uname)" == Darwin ]]; then
    alias sed='gsed'
    fgp() { security find-generic-password -a "$USER" -s "$1" -w; }

    # backup script scans these literal references to preserve the complete Keychain inventory.
    : fgp RESTIC_PASSWORD
    : fgp LAN_ADDR
    : fgp PATH_ADDR
    : fgp PROXY_ADDR
    : fgp SN_PASS
    : fgp SN_PASS_FAT
    : fgp JIRA_URL
    : fgp JIRA_TOKEN
    : fgp CONFLUENCE_TOKEN
    : fgp CORP_DOMAIN
    : fgp CORP_DOMAIN_LONG
    : fgp BITBUCKET_TOKEN
    : fgp BITBUCKET_ADDRESS
    : fgp TFE_FAT_TOKEN
    : fgp TFE_PROD_TOKEN
    : fgp EBHUGHE_TOKEN
    : fgp NETBOX_FAT_TOKEN
    : fgp TWINE_USERNAME
    : fgp TWINE_PASSWORD

    # SSH via PATH
    sshviapath() {
        local lan_addr="$(fgp LAN_ADDR)" path_addr="$(fgp PATH_ADDR)"
        ssh "$USER@$1@$2.$lan_addr@ssh.$path_addr"
    }
    alias ibis1='sshviapath '$USER' ibis1'
    alias ibis2='sshviapath '$USER' ibis2'
fi
alias s='source ~/.zshrc'
alias cd="z"
cfg() { command git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"; }
unalias l 2>/dev/null
l() {
    local remote_branch branch

    command git fetch --prune origin || return 1
    remote_branch=$(command git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/remotes/origin |
        sed '/^origin\/HEAD$/d' |
        head -n1)

    if [[ -z "$remote_branch" ]]; then
        echo "No remote branches found on origin." >&2
        return 1
    fi

    branch="${remote_branch#origin/}"
    if command git show-ref --verify --quiet "refs/heads/$branch"; then
        command git switch "$branch"
    else
        command git switch --track -c "$branch" "$remote_branch"
    fi
}
git() {
    if [[ "$PWD" == "$HOME" ]] && [[ ! -d ".git" ]]; then
        if [[ $(ps -p $PPID -o comm= 2>/dev/null) != *"brew"* ]]; then
             command git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"
             return
        fi
    fi
    command git "$@"
}
p() { system_profiler SPPowerDataType | grep -E "Wattage|Amperage|Voltage"; }
b() {
    default_branch=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')
    gco $default_branch && sync
}
backup() {
    RESTIC_PASSWORD="$(fgp RESTIC_PASSWORD)" /Volumes/Backup/backup.sh --backup "$@"
}
restore() {
    RESTIC_PASSWORD="$(fgp RESTIC_PASSWORD)" /Volumes/Backup/backup.sh --restore "$@"
}
secret() {
    local action="$1"
    local name="$2"

    case "$action" in
        set|add)
            if [ -z "$name" ]; then
                echo "Usage: secret set <name>"
                return 1
            fi
            security add-generic-password -U -a "$USER" -s "$name" -w
            ;;
        get)
            if [ -z "$name" ]; then
                echo "Usage: secret get <name>"
                return 1
            fi
            security find-generic-password -a "$USER" -s "$name" -w
            ;;
        delete|del|rm)
            if [ -z "$name" ]; then
                echo "Usage: secret delete <name>"
                return 1
            fi
            security delete-generic-password -a "$USER" -s "$name"
            ;;
        *)
            echo "Usage: secret <set|get|delete> <name>"
            return 1
            ;;
    esac
}
tfelog() {
    emulate -L zsh
    setopt nounset pipefail

    local TFE_HOST="${TFE_HOST-}" TFE_ORG="${TFE_ORG-}" DAYS="${DAYS-}" MESSAGE="${MESSAGE-}"
    local CREDENTIALS_FILE="$HOME/.terraform.d/credentials.tfrc.json"
    local show_url=1 argument input_name usage
    local TFE_TOKEN SINCE response page=1 matches=0 errored_runs=0
    local run run_details created run_id workspace_id workspace plan_id apply_id phase phase_id log_url scan_task matched_jobs match
    local oldest next_page affected_count
    local -A workspace_names affected_runs
    local -a api_headers scan_jobs

    usage="Usage: tfelog [--host HOST] [--org ORG] [--days N] [--message TEXT] [--no-url]"
    while (( $# > 0 )); do
        argument="$1"
        case "$argument" in
            --no-url) show_url=0 ;;
            --days|--host|--org|--message)
                if (( $# < 2 )) || [[ -z "$2" ]]; then
                    print -u2 "$argument requires a value"
                    print -u2 "$usage"
                    return 2
                fi
                case "$argument" in
                    --days)
                        if [[ ! "$2" =~ '^[1-9][0-9]*$' ]]; then
                            print -u2 "--days requires a positive integer"
                            print -u2 "$usage"
                            return 2
                        fi
                        DAYS="$2"
                        ;;
                    --host) TFE_HOST="$2" ;;
                    --org) TFE_ORG="$2" ;;
                    --message) MESSAGE="$2" ;;
                esac
                shift
                ;;
            *)
                print -u2 "Unknown option: $argument"
                print -u2 "$usage"
                return 2
                ;;
        esac
        shift
    done

    for input_name in TFE_HOST TFE_ORG DAYS MESSAGE; do
        if [[ -z "${(P)input_name}" ]]; then
            print -u2 "Missing required input: $input_name"
            print -u2 "Set $input_name or provide its command-line option."
            return 2
        fi
    done
    if [[ ! "$DAYS" =~ '^[1-9][0-9]*$' ]]; then
        print -u2 "DAYS must be a positive integer"
        return 2
    fi
    if ! command -v curl >/dev/null || ! command -v jq >/dev/null; then
        print -u2 "Required commands are missing: curl and jq"
        return 1
    fi
    if [[ ! -r "$CREDENTIALS_FILE" ]]; then
        print -u2 "Terraform credentials file is not readable: $CREDENTIALS_FILE"
        return 1
    fi

    TFE_TOKEN="$(jq -er --arg host "$TFE_HOST" '.credentials[$host].token' "$CREDENTIALS_FILE")" || {
        print -u2 "No Terraform login token found for $TFE_HOST"
        return 1
    }
    SINCE="$(date -u -v-"${DAYS}"d '+%Y-%m-%dT%H:%M:%SZ')"
    api_headers=(-H "Authorization: Bearer ${TFE_TOKEN}" -H 'Content-Type: application/vnd.api+json')

    if (( show_url )); then
        printf '%-24s %-50s %-8s %s\n' 'CREATED_AT' 'WORKSPACE' 'PHASE' 'RUN_URL'
    else
        printf '%-24s %-50s %-8s\n' 'CREATED_AT' 'WORKSPACE' 'PHASE'
    fi

    while true; do
        response="$(curl -fsS -G --retry 3 "${api_headers[@]}" \
            "https://${TFE_HOST}/api/v2/organizations/${TFE_ORG}/runs" \
            --data-urlencode 'filter[operation]=plan_only,plan_and_apply,save_plan,refresh_only,destroy,empty_apply' \
            --data-urlencode 'filter[status]=errored' \
            --data-urlencode "page[number]=${page}" --data-urlencode 'page[size]=100')" || {
            print -u2 "Failed to retrieve runs page $page"
            return 1
        }

        while IFS= read -r run; do
            created="$(jq -r '.created' <<<"$run")"
            [[ "$created" < "$SINCE" ]] && continue
            ((errored_runs += 1))

            run_id="$(jq -r '.run_id' <<<"$run")"
            workspace_id="$(jq -r '.workspace_id' <<<"$run")"
            if [[ -z "${workspace_names[$workspace_id]-}" ]]; then
                workspace_names[$workspace_id]="$(curl -fsS --retry 3 "${api_headers[@]}" \
                    "https://${TFE_HOST}/api/v2/workspaces/${workspace_id}" | jq -er '.data.attributes.name')" || {
                    print -u2 "Could not resolve workspace $workspace_id for $run_id"
                    continue
                }
            fi
            workspace="${workspace_names[$workspace_id]}"
            plan_id="$(jq -r '.plan_id // empty' <<<"$run")"
            apply_id="$(jq -r '.apply_id // empty' <<<"$run")"
            [[ -z "$plan_id" && -z "$apply_id" ]] && continue

            run_details="$(curl -fsS -G --retry 3 "${api_headers[@]}" \
                "https://${TFE_HOST}/api/v2/runs/${run_id}" \
                --data-urlencode 'include=plan,apply')" || {
                print -u2 "Could not retrieve phase metadata for $run_id"
                continue
            }

            for phase in plan apply; do
                phase_id="$(jq -r --arg phase "$phase" '.[$phase + "_id"] // empty' <<<"$run")"
                [[ -z "$phase_id" ]] && continue
                log_url="$(jq -r --arg phase "$phase" --arg phase_id "$phase_id" '
                    .included[]?
                    | select(.type == (if $phase == "apply" then "applies" else "plans" end) and .id == $phase_id)
                    | .attributes["log-read-url"] // empty
                ' <<<"$run_details")"
                [[ -z "$log_url" ]] && continue
                scan_task="$(jq -cn --arg log_url "$log_url" --arg created "$created" \
                    --arg workspace "$workspace" --arg run_id "$run_id" --arg phase "$phase" \
                    '{log_url: $log_url, created: $created, workspace: $workspace, run_id: $run_id, phase: $phase}')"
                scan_jobs+=("$scan_task")
            done
        done < <(jq -c '
            . as $page
            | .data[]
            | . as $run
            | {
                run_id: $run.id,
                created: $run.attributes["created-at"],
                workspace_id: $run.relationships.workspace.data.id,
                plan_id: ($run.relationships.plan.data.id // ""),
                apply_id: ($run.relationships.apply.data.id // "")
            }
        ' <<<"$response")

        if (( ${#scan_jobs} > 0 )); then
            matched_jobs="$(printf '%s\0' "${scan_jobs[@]}" | xargs -0 -P 6 -n 1 /bin/zsh -fc '
                emulate -L zsh
                setopt pipefail
                local log_url="$(jq -r ".log_url" <<<"$2")"
                if curl -fsSL --retry 3 "$log_url" | grep -F "$1" >/dev/null; then
                    print -r -- "$2"
                fi
            ' _ "$MESSAGE")" || {
                print -u2 "Failed while scanning logs for runs page $page"
                return 1
            }

            if [[ -n "$matched_jobs" ]]; then
                while IFS= read -r match; do
                    created="$(jq -r '.created' <<<"$match")"
                    workspace="$(jq -r '.workspace' <<<"$match")"
                    run_id="$(jq -r '.run_id' <<<"$match")"
                    phase="$(jq -r '.phase' <<<"$match")"
                    if (( show_url )); then
                        printf '%-24s %-50s %-8s %s\n' "$created" "$workspace" "$phase" \
                            "https://${TFE_HOST}/app/${TFE_ORG}/workspaces/${workspace}/runs/${run_id}"
                    else
                        printf '%-24s %-50s %-8s\n' "$created" "$workspace" "$phase"
                    fi
                    affected_runs[$run_id]=1
                    ((matches += 1))
                done < <(jq -sc 'sort_by(.created) | reverse[]' <<<"$matched_jobs")
            fi
            scan_jobs=()
        fi

        oldest="$(jq -r '.data[-1].attributes["created-at"] // empty' <<<"$response")"
        [[ -n "$oldest" && "$oldest" < "$SINCE" ]] && break
        next_page="$(jq -r '.meta.pagination["next-page"] // empty' <<<"$response")"
        [[ -z "$next_page" ]] && break
        page="$next_page"
    done

    affected_count=${#affected_runs}
    if (( errored_runs > 0 )); then
        printf 'Matching errored runs: %s/%s; matching phases: %s\n' \
            "$affected_count" "$errored_runs" "$matches" >&2
    else
        print -u2 "No errored runs found since $SINCE"
    fi
}
ba() {
    original_dir=$(pwd)
    for i in $(find ~/repos -name '.git' -type d); do
        cd "$(dirname "$i")" || {
            echo "[ERROR] $(dirname "$i"): Failed to cd" >&2
            continue
        }

        b || echo "[ERROR] $(dirname "$i"): b() failed"

        cd "$original_dir" || {
            echo "[ERROR] Failed to return to $original_dir" >&2
            exit 1
        }
    done
}
dot() {
    url="https://github.com/pduchnovsky/dotfiles"
    if [[ "$(uname)" == "Darwin" ]]; then
        open -a "Vivaldi" "$url"
    elif grep -qiE "(Microsoft|WSL)" /proc/version 2>/dev/null; then
        "/mnt/c/Program Files (x86)/Vivaldi/Application/vivaldi.exe" "$url"
    elif command -v xdg-open &>/dev/null; then
        xdg-open "$url"
    fi
}

tf() { terraform $@; }
tfi() { tf init "$@"; }

pre() {
    local repo_root current_dir temp_base cloud_config cloud_link tf_file
    local has_cloud=0 init_upgrade=0
    local CORP_DOMAIN_LONG="$(fgp CORP_DOMAIN_LONG)"

    if [[ "${1:-}" == upgrade ]]; then
        init_upgrade=1
        shift
    fi

    current_dir="$PWD"
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    temp_base="${TMPDIR:-/tmp}"
    cloud_config="${temp_base%/}/pre-commit-cloud.tf"

    for tf_file in "$PWD"/*.tf(N); do
        if grep -Eq '^[[:space:]]*cloud[[:space:]]*\{' "$tf_file"; then
            has_cloud=1
        fi
    done

    if (( has_cloud )); then
        (
            cd "$current_dir" || exit 1
            if (( init_upgrade )); then
                tf init -upgrade || exit $?
            elif [[ ! -s .terraform/modules/modules.json ]]; then
                tf init || exit $?
            fi
            cd "$repo_root" || exit 1
            pre-commit run --all-files "$@"
        )
        return $?
    fi

    if [[ ! -f "$cloud_config" ]]; then
        printf '%s\n' \
            'terraform {' \
            '  cloud {' \
            '    organization = "iac-management"' \
            '    hostname     = "terraform.fat.'"${CORP_DOMAIN_LONG}"'"' \
            '    workspaces {' \
            '      name = "tfe-2-modules"' \
            '    }' \
            '  }' \
            '}' > "$cloud_config" || return 1
    fi

    cloud_link="${current_dir}/pre-cloud-${$}.tf"

    (
        cd "$current_dir" || exit 1
        ln -s "$cloud_config" "$cloud_link" || exit 1
        trap 'command rm -f "$cloud_link"' EXIT
        if (( init_upgrade )); then
            tf init -upgrade || exit $?
        elif [[ ! -s .terraform/modules/modules.json ]]; then
            tf init || exit $?
        fi
        cd "$repo_root" || exit 1
        pre-commit run --all-files "$@"
    )
}

republish() {
    local url="$1" host org ns mod prov ver temp="999.999.999" token branch tags ident sha payload
    local CORP_DOMAIN_LONG="$(fgp CORP_DOMAIN_LONG)" BITBUCKET_ADDRESS
    [[ -z "$url" ]] && { echo "Usage: republish <module-registry-url>" >&2; return 1; }
    [[ "$url" =~ '^https://([^/]+)/app/([^/]+)/registry/modules/private/([^/]+)/([^/]+)/([^/]+)(/([0-9][^/]*))?/?$' ]] || { echo "Bad module URL" >&2; return 1; }
    host="${match[1]}"; org="${match[2]}"; ns="${match[3]}"; mod="${match[4]}"; prov="${match[5]}"; ver="${match[7]:-1.0.0}"

    case "$host" in
        "terraform.${CORP_DOMAIN_LONG}") token="$(fgp TFE_PROD_TOKEN)" ;;
        "terraform.fat.${CORP_DOMAIN_LONG}") token="$(fgp TFE_FAT_TOKEN)" ;;
        *) echo "Unknown TFE host: $host" >&2; return 1 ;;
    esac
    [[ -z "$token" ]] && { echo "Missing TFE token for $host" >&2; return 1; }

    local base="https://${host}/api/v2/organizations/${org}/registry-modules/private/${ns}/${mod}/${prov}"
    _rp() {
        local out code
        local -a extra
        [[ -n "$3" ]] && extra=(--data "$3")
        out="$(curl -sS -w $'\n%{http_code}' -H "Authorization: Bearer ${token}" -H "Content-Type: application/vnd.api+json" --request "$1" "${extra[@]}" "$2")" || return 1
        code="${out##*$'\n'}"; out="${out%$'\n'*}"
        if (( code < 200 || code >= 300 )); then
            echo "HTTP $code: $1 $2" >&2
            jq -r '.errors[]?|"  - "+(.title//"")+": "+(.detail//"")' <<<"$out" >&2 2>/dev/null
            return 1
        fi
        echo "$out"
    }

    local mjson; mjson="$(_rp GET "$base")" || return 1
    tags="$(jq -r '.data.attributes["vcs-repo"].tags // false' <<<"$mjson")"
    branch="$(jq -r '.data.attributes["vcs-repo"].branch // empty' <<<"$mjson")"
    [[ "$tags" == "true" || -z "$branch" ]] && { echo "Module is tag-based or has no branch, aborting" >&2; return 1; }

    ident="$(jq -r '.data.attributes["vcs-repo"].identifier // empty' <<<"$mjson")"
    BITBUCKET_ADDRESS="$(fgp BITBUCKET_ADDRESS)"
    sha="$(git ls-remote "ssh://git@${BITBUCKET_ADDRESS}:7999/${ident}.git" "refs/heads/${branch}" | awk '{print $1}')"
    [[ -z "$sha" ]] && { echo "Could not resolve latest commit for ${ident}@${branch}" >&2; return 1; }

    echo "Republishing ${ns}/${mod}/${prov} @ ${sha} (branch ${branch}):"
    jq -r '.data.attributes["version-statuses"][] | "  " + .version + " (" + .status + ")"' <<<"$mjson"
    read "ok?Create temp ${temp}, delete+recreate ${ver}, then remove ${temp}? [y/N] "
    [[ "$ok" == [yY]* ]] || { echo "Aborted."; return 0; }

    payload='{"data":{"type":"registry-module-versions","attributes":{"version":"'"$temp"'","commit-sha":"'"$sha"'"}}}'
    _rp POST "${base}/versions" "$payload" >/dev/null || return 1
    _rp DELETE "${base}/${ver}" >/dev/null || return 1
    payload='{"data":{"type":"registry-module-versions","attributes":{"version":"'"$ver"'","commit-sha":"'"$sha"'"}}}'
    _rp POST "${base}/versions" "$payload" >/dev/null || return 1
    _rp DELETE "${base}/${temp}" >/dev/null || return 1
    echo "Done."
}
brew() {
    local brew_bin="$HOMEBREW_PREFIX/bin/brew"
    local PROXY_ADDR="$(fgp PROXY_ADDR)"
    if ping -c1 -W1 "$PROXY_ADDR" &>/dev/null; then
        ALL_PROXY="socks5://$PROXY_ADDR:80" "$brew_bin" "$@"
    else
        "$brew_bin" "$@"
    fi
}
bb() { HOMEBREW_NO_UPDATE_REPORT_NEW=1 brew bundle dump -f && sed -i '/^vscode/d' Brewfile; }
bbi() { HOMEBREW_NO_UPDATE_REPORT_NEW=1 brew bundle install --file Brewfile; }
bu() {
    HOMEBREW_NO_UPDATE_REPORT_NEW=1 brew upgrade --greedy
    cp ~/Documents/pics/vivaldi.icns /Applications/Vivaldi.app/Contents/Resources/app.icns
}
br() {
    for pkg in "$@"; do
        if brew info --cask "$pkg" &>/dev/null; then
            brew uninstall --zap --cask -f "$pkg"
        else
            brew uninstall --zap -f "$pkg"
        fi
    done
}
ggo() {
    local remote_url repo_path project repo web_url
    remote_url=$(git remote get-url origin) || return 1

    case "$remote_url" in
    https://github.com/*/*|http://github.com/*/*)
        web_url="${remote_url%.git}"
        ;;
    git@github.com:*/*)
        repo_path="${remote_url#git@github.com:}"
        repo_path="${repo_path%.git}"
        web_url="https://github.com/${repo_path}"
        ;;
    https://*.ghe.com/*|http://*.ghe.com/*)
        web_url="${remote_url%.git}"
        ;;
    ssh://git@stash.s-mxs.net:7999/*/*)
        repo_path="${remote_url#ssh://git@stash.s-mxs.net:7999/}"
        repo_path="${repo_path%.git}"
        project="${repo_path%%/*}"
        repo="${repo_path#*/}"
        web_url="https://stash.s-mxs.net/projects/${project}/repos/${repo}/browse"
        ;;
    *)
        echo "Unsupported origin URL: $remote_url" >&2
        return 1
        ;;
    esac

    open "$web_url"
}
fr() {
    local BITBUCKET_ADDRESS="$(fgp BITBUCKET_ADDRESS)" BITBUCKET_TOKEN="$(fgp BITBUCKET_TOKEN)"
    clonerepo() {
        local opt project repo target_dir
        opt=$([ "$1" = sol ] && echo ".solution_projects/" || echo "")
        PROJECTS_ARRAY=()
        read -a projects_array <<<"$PROJECTS" 2>/dev/null || read -A projects_array <<<"$PROJECTS"
        for project in "${projects_array[@]}"; do
            PROJECTS_ARRAY+=("https://$BITBUCKET_ADDRESS/rest/api/1.0/projects/$project/repos?limit=1000")
        done
        TARGET=$(printf "%s\n" "${PROJECTS_ARRAY[@]}" |
            xargs -P10 -n1 curl -ks -u "${USER}:$BITBUCKET_TOKEN" |
            jq -r '.values|.[] | "\(.project.key)/\(.name)"' | fzf)
        [[ -z "$TARGET" ]] && return 130

        project="${TARGET%%/*}"
        repo="${TARGET#*/}"
        target_dir="$HOME/repos/${opt}${TARGET}"

        if [[ "$project" == "HORIZON" ]]; then
            case "${(L)repo}" in
            *aws*) target_dir="$HOME/repos/HORIZON/AWS/$repo" ;;
            *gcp*) target_dir="$HOME/repos/HORIZON/GCP/$repo" ;;
            esac
        fi

        [[ ! -d "$target_dir" ]] && command git clone "ssh://git@$BITBUCKET_ADDRESS:7999/$TARGET.git" "$target_dir"
        cd "$target_dir"
    }
    case "$1" in
    sol)
        local factory cloud factory_dir
        local -a factory_projects=(
            "GCP:terraform-gcp-factory-solution-project"
            "AWS:terraform-aws-factory-account-tailoring"
        )
        local -a organization_dirs=()
        local -a projects=()

        for factory in "${factory_projects[@]}"; do
            cloud="${factory%%:*}"
            SOL_FACTORY_PROJECT="${factory#*:}"
            factory_dir="$HOME/repos/HORIZON/$cloud/$SOL_FACTORY_PROJECT"
            if [[ ! -d "$factory_dir" ]]; then
                command git clone "ssh://git@$BITBUCKET_ADDRESS:7999/HORIZON/$SOL_FACTORY_PROJECT.git" "$factory_dir" || return 1
            fi
            organization_dirs+=("$factory_dir/organization")

            while IFS= read -r project; do
                [[ -n "$project" ]] && projects+=("$project")
            done < <(find "$factory_dir/organization" -type f -name '*.yaml' -print0 |
                xargs -0 -n1 yq -r "if .vcs_project then .vcs_project elif \"$cloud\" == \"AWS\" then \"aws-\" + .solution_name + \"-\" + .use_case else \"\" end")
        done

        PROJECTS=$(printf '%s\n' "${projects[@]}" |
            tr '[:lower:]' '[:upper:]' | sort -u | grep -v '^NULL$' | xargs)
        clonerepo sol
        ;;
    '')
        PROJECTS="HORIZON TFE-GCP-MODULES TFE-AWS-MODULES CS-ATRON CS-HORIZON VAULT TERRAFORM-SERVICE TFE-GCP-DATABASES TFE-TFE-MODULES onecloud-aws"
        clonerepo
        ;;
    *)
        PROJECTS="$*"
        clonerepo
        ;;
    esac
}
adm() {
    case "$1" in
    "add")
        sudo /usr/sbin/dseditgroup -o edit -a $USER -t user admin
        ;;
    "rm")
        sudo /usr/sbin/dseditgroup -o edit -d $USER -t user admin
        ;;
    esac
}
cg() {
    for repo in $(find ~/repos -name '.git' -type d); do
        echo $repo
        git --git-dir="$repo" --work-tree="$repo/.." fetch -p >/dev/null && git --git-dir="$repo" --work-tree="$repo/.." gc >/dev/null 2>&1
        for branch in $(git --git-dir="$repo" --work-tree="$repo/.." for-each-ref --format '%(refname) %(upstream:track)' refs/heads | awk '$2 == "[gone]" {sub("refs/heads/", "", $1); print $1}'); do
            git --git-dir="$repo" --work-tree="$repo/.." branch -D $branch
        done
    done
}
sync() {
    case "$1" in
    "")
        git fetch --all --prune -a
        (git pull --recurse-submodules 2>/dev/null) | grep "Updated branch"
        git branch -vv | awk "/: gone]/ {print \$1}" | xargs -r git branch -D
        ;;
    *)
        head_branch=$(git remote show $1 | grep "HEAD branch:" | awk '{print $3}')
        git fetch --prune -a $1
        git merge $1/$head_branch --no-commit --strategy-option theirs
        git submodule update --recursive
        ;;
    esac
}
syncall() {
    find ~/repos -name '.git' -type d | xargs -n 1 -P 15 -S 1024 -I {} bash -c '
        repo_path="$(dirname "{}")"

        cd "$repo_path" || {
            echo "[ERROR] $repo_path: Failed to cd" >&2
            exit 1
        }

        # Run git fetch and suppress normal output
        git fetch --all --prune > /dev/null 2>&1 || \
            echo "[ERROR] $repo_path: fetch failed"

        # Run git pull, suppress "Already up to date" and show only real errors
        pull_output=$(git pull --recurse-submodules 2>&1)
        if [ $? -ne 0 ]; then
            echo "[ERROR] $repo_path: pull failed: $pull_output"
        fi

        # Delete gone branches if any
        gone_branches=$(git branch -vv | awk "/: gone]/ {print \$1}")
        if [ -n "$gone_branches" ]; then
            echo "$gone_branches" | xargs -r git branch -D 2>&1
        fi
    '
}
rebase() { git fetch origin && git rebase origin/$1; }
push() {
    if [[ $# -eq 0 ]]; then
        read -p "Commit description: " desc
    else
        desc="$*"
    fi
    noverify=
    if [[ "$desc" == -nv\ * ]]; then
        noverify="--no-verify"
        desc="${desc#-nv }"
    elif [[ "$desc" == *\ -nv ]]; then
        noverify="--no-verify"
        desc="${desc% -nv}"
    fi
    if [ "$(pwd)" = "$HOME" ]; then
        cfg commit -a --allow-empty-message $noverify -m "$desc" && cfg push $noverify
    else
        git add -A && git commit -a --allow-empty-message $noverify -m "$desc" && git push $noverify
    fi
}
task() {
    local JIRA_TOKEN="$(fgp JIRA_TOKEN)" JIRA_URL="$(fgp JIRA_URL)"

  red=`tput setaf 1`
  green=`tput setaf 2`
  reset=`tput sgr0`

  if [[ -z "${JIRA_TOKEN}" ]]; then
    echo "Missing env. variable JIRA_TOKEN"
  else
    CMD=$(echo curl -k --url "https://${JIRA_URL}/rest/api/latest/issue" \
      --header "Authorization: Bearer ${JIRA_TOKEN}" \
      --header "Accept: application/json" \
      --header "Content-Type: application/json" \
      --data '{
        "fields":
          {
            "project": {"key": "CEP"},
            "summary": "'"${*}"'",
            "description": "'"${*}"'",
            "issuetype": {"id": "6"},
            "labels": ["TEST"],
          }
        }')

    echo  "$(echo ${CMD} | sed -E 's/Bearer [a-zA-Z0-9]+/Bearer *****/')"
    echo
    echo "Would you like to ${green}execute above cURL${reset} call ${red}[y|Y|yes]${reset} or ${green}[n|no|N]${reset}?"
    read choice

    case "$choice" in
      y|Y|yes|Yes )
        # set -x
        echo "Executing."
        KEY=$(curl -s -k --url "https://${JIRA_URL}/rest/api/2/issue" \
        --header "Authorization: Bearer ${JIRA_TOKEN}" \
        --header "Accept: application/json" \
        --header "Content-Type: application/json" \
        --data '{
          "fields":
            {
              "project": {"key": "CEP"},
              "summary": "'"${*}"'",
              "description": "'"${*}"'",
              "issuetype": {"id": "6"},
              "labels": ["SRE"]
            }
          }' | jq -r '.key')

        text=$(echo "${*}" | tr " " "-")
        echo "https://${JIRA_URL}/browse/${KEY}"
        echo "git checkout -b feature/${KEY}-${text}" #| pbcopy
        sleep 0.5
        echo "push \"${KEY} ${*}\"" #| pbcopy

        ;;
      n|N|no ) echo "No cURL call was executed";;
      * ) echo "invalid";;
    esac
  fi
}
sn() {(
    SOL_FACTORY_PROJECT=terraform-gcp-factory-solution-project
    cd "$HOME/repos/HORIZON/GCP/$SOL_FACTORY_PROJECT" || return 1
    source tools/venv_solf/bin/activate
    PIP_EXTRA_INDEX_URL="https://$(fgp TWINE_USERNAME):$(fgp TWINE_PASSWORD)@repo.$(fgp LAN_ADDR)/artifactory/api/pypi/pypi-repo/simple" \
        pip install -r tools/requirements.txt > /dev/null 2>&1

    local SN_ENV="prod"
    local RITM_ARG

    if [[ "$1" == "fat" ]]; then
        SN_ENV="fat"
        RITM_ARG="$2"
    else
        RITM_ARG="$1"
    fi

    if [[ -z "$RITM_ARG" ]]; then
        echo "Usage: sn [fat] <RITM>"
        return 1
    fi

    local SN_PASS="$(fgp SN_PASS)" CORP_DOMAIN_LONG="$(fgp CORP_DOMAIN_LONG)"

    RITM="$RITM_ARG" SN_ENV="$SN_ENV" SN_PASS="$SN_PASS" CORP_DOMAIN_LONG="$CORP_DOMAIN_LONG" python3 - <<'PY'
import os
from pprint import pprint
from python_utils.service_now.utils import get_sysids, get_sn_tfvariables

ritm = os.getenv("RITM")
sn_env = os.getenv("SN_ENV", "prod")

base_url = "https://api.automation." + (".fat." if sn_env == "fat" else "") + os.getenv("CORP_DOMAIN_LONG")
autom_url = base_url + ("/fat" if sn_env == "fat" else "")

sn_pass = os.getenv("SN_PASS")
sn_pairs = get_sysids(
    username="horizon.rest",
    password=sn_pass,
    autom_url=autom_url,
    ritms=[ritm],
)

p = get_sn_tfvariables("horizon.rest", sn_pass, autom_url, list(sn_pairs.values())[0])
values = {}
[values.update({i["name"]: i["value"]}) for i in p["records"][0]["variables"]]
pprint(values)
PY
)}
presentation() {
    local JIRA_TOKEN="$(fgp JIRA_TOKEN)" JIRA_URL="$(fgp JIRA_URL)"
    if [[ -z "${JIRA_TOKEN}" ]]; then
        echo "Missing env. variable JIRA_TOKEN"
    else
        red=$(tput setaf 1)
        green=$(tput setaf 2)
        reset=$(tput sgr0)

        JIRA_BOARD="4136" # Horizon Sprint Board identifier
        JIRA_CURRENT_SPRINT=$(curl -s -k --header 'Accept: application/json' \
            --header "Authorization: Bearer ${JIRA_TOKEN}" \
            --request GET --url "https://${JIRA_URL}/rest/agile/1.0/board/${JIRA_BOARD}/sprint?state=active" | jq '.values | .[].id')
        JIRA_CURRENT_SPRINT_GOAL=$(curl -s -k --header 'Accept: application/json' \
            --header "Authorization: Bearer ${JIRA_TOKEN}" \
            --request GET --url "https://${JIRA_URL}/rest/agile/1.0/board/${JIRA_BOARD}/sprint?state=active" | jq -r '.values | .[].goal')

        JIRA_CURRENT_SPRINT_NAME=$(curl -s -k --header 'Accept: application/json' \
            --header "Authorization: Bearer ${JIRA_TOKEN}" \
            --request GET --url "https://${JIRA_URL}/rest/agile/1.0/board/${JIRA_BOARD}/sprint?state=active" | jq -r '.values | .[].name')

        export MAX_ENTRIES="1000"

        echo "${green}Sprint Goal${reset}: ${JIRA_CURRENT_SPRINT_GOAL}"
        echo "${green}Sprint Name${reset}: ${JIRA_CURRENT_SPRINT_NAME}"

        echo "${green}Stories:${reset}"
        curl -s -k --header 'Accept: application/json' \
            --header "Authorization: Bearer ${JIRA_TOKEN}" \
            --request GET --url "https://${JIRA_URL}/rest/agile/1.0/board/${JIRA_BOARD}/sprint/${JIRA_CURRENT_SPRINT}/issue?startAt=0&maxResults=${MAX_ENTRIES}" |
            jq -r '.issues | .[] | select(.fields.issuetype.name=="Story" and .fields.status.statusCategory.name=="Done") |
          (
              {
                "key": ("* " + .key),
                "summary": (.fields.summary),
                "assignee": ("[" + .fields.assignee.emailAddress | split(".")[0] + "]")
              }
              )' | jq -sr '. |=sort_by(.assignee) | .[] | join(" ")'

        echo "${green}Worth to mention:${reset}"
        curl -s -k --header 'Accept: application/json' \
            --header "Authorization: Bearer ${JIRA_TOKEN}" \
            --request GET --url "https://${JIRA_URL}/rest/agile/1.0/board/${JIRA_BOARD}/sprint/${JIRA_CURRENT_SPRINT}/issue?startAt=0&maxResults=${MAX_ENTRIES}" |
            jq -r '.issues | .[] | select(.fields.issuetype.name=="Task") |
          (
              {
                "key": ("* " + .key),
                "summary": (.fields.summary),
                "assignee": ("[" + .fields.assignee.emailAddress | split(".")[0] + "]")
              }
              )' | jq -sr '. |=sort_by(.assignee) | .[] | join(" ")'
    fi

}

